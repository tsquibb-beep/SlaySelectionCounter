// Slay Selection Counter — settings. Restart the game after editing.
//
// Copy this file to your save folder to keep your settings through mod updates:
//   %APPDATA%\SlayTheSpire2\SlaySelectionCounter.config.jsonc
// That copy is read in preference to this one.
{
    // Master switch for the whole mod.
    "enabled": true,

    // How the count is shown:
    //   "prompt" - appends "(7/10)" to the instruction text at the bottom of the screen
    //   "badge"  - a large separate counter above where the Confirm button appears
    //              (experimental: its placement has had less testing than "prompt")
    //   "both"   - both of the above
    "style": "prompt",

    // Badge style only: text size, colour while picking, and colour once full.
    "badgeFontSize": 56,
    "badgeColor": "#fff6e2",
    "badgeFullColor": "#efc851"
}
